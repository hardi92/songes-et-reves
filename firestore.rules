rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidRecord(data, userId) {
      return data.userId == userId &&
             data.title is string &&
             data.category is string &&
             data.rawAudioText is string;
    }

    match /users/{userId}/records/{recordId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidRecord(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidRecord(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }
  }
}
